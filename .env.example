PORT=4000
LOG_LEVEL=info
TRUST_PROXY=true

# Verified against every /tools/* request Ultravox makes. Must match the demo bridge's
# TOOLS_API_KEY — that service configures Ultravox with this key, this one verifies it.
TOOLS_API_KEY=replace-with-random-hex-min-32-chars

# Verified against /internal/* requests. Only schedurx-ultravox-demo-api should have this.
INTERNAL_API_KEY=replace-with-random-hex-min-32-chars

# ── Clinic business data ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# ── Nettu-scheduler (nittei) ─────────────────────────────────────────────────────
# Point NETTU_BASE_URL at your running nettu-scheduler (self-hosted or cloud).
# The NETTU_API_KEY is the account-level API key created when you set up nettu.
NETTU_BASE_URL=https://your-nettu-scheduler.example.com
NETTU_API_KEY=replace-with-your-nettu-account-api-key
# NETTU_DB_PASSWORD is only needed when running your own nettu-scheduler server,
# not by this application's HTTP client.
NETTU_DB_PASSWORD=replace-with-your-nettu-db-password
# Run `node scripts/setup-nettu-webhook.js <this-server's-public-url>/webhooks/nettu-reminders`
# once to register where nettu sends event reminders, then paste the key it
# prints here. POST /webhooks/nettu-reminders stays unmounted without it.
NETTU_WEBHOOK_KEY=

CLINIC_ID=poc-clinic-001

# ── Firebase Admin (staff auth + RBAC) ──────────────────────────────────────────
# All three required together to mount /api/v1. Leave unset and the dashboard API
# simply doesn't mount — /tools and /internal are unaffected either way.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service account's private key with literal \n escapes preserved.
# WARNING: some platforms' env-var loaders (notably systemd's EnvironmentFile,
# used on plain VM/Droplet deploys) silently strip the backslash out of "\n",
# corrupting this form. Prefer FIREBASE_PRIVATE_KEY_BASE64 below on those platforms.
FIREBASE_PRIVATE_KEY=
# Base64 of the raw PEM (e.g. `node -e "console.log(Buffer.from(require('./sa.json').private_key).toString('base64'))"`).
# Immune to the escaping issue above. Takes precedence over FIREBASE_PRIVATE_KEY when both are set.
FIREBASE_PRIVATE_KEY_BASE64=

# ── Realtime JWT bridge ──────────────────────────────────────────────────────────
# Your Supabase project's JWT secret (Project Settings → API). Used to mint
# short-lived tokens for browser Realtime subscriptions on QueueItem. Without it,
# GET /api/v1/realtime-token returns 501 and the dashboard falls back to polling.
SUPABASE_JWT_SECRET=

# ── Stripe billing ────────────────────────────────────────────────────────────────
# Both required together to mount /api/v1/billing's checkout-session route and
# /webhooks/stripe. Invoice listing works without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────────
# Required to mount /api/v1/ai (currently: triage classification).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Web push (VAPID) ──────────────────────────────────────────────────────────────
# Generate with `npx web-push generate-vapid-keys`. Without both, push sends are
# logged and skipped rather than failing the request they're attached to.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@schedurx.example

# ── Dashboard CORS ────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins the dashboard frontend is served
# from, e.g. "http://localhost:3000,https://app.schedurx.in". No CORS middleware
# is applied to /api/v1 at all until this is set.
CORS_ALLOWED_ORIGIN=

# ── Public patient-facing API CORS ──────────────────────────────────────────────────
# /api/v1/public/* (schedurx-form-agent's booking API) always allows
# PATIENT_APP_BASE_URL below as an origin; add anything else here (e.g. a
# local dev origin) comma-separated.
PUBLIC_CORS_ALLOWED_ORIGIN=

# ── Twilio (Voice/SMS/WhatsApp) ─────────────────────────────────────────────────────
# One shared platform account — Console → Account → API keys & tokens for both.
# /webhooks/twilio/* stay unmounted without TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Fallback senders (number or Messaging Service SID) used when a clinic has no
# sender of its own configured for outbound SMS/WhatsApp.
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Meta-approved Content Template variables: {{1}} clinic name, {{2}} role,
# {{3}} invite URL. Strongly recommended so a new team member can receive the
# business-initiated WhatsApp invite outside an existing 24-hour session.
TWILIO_TEAM_INVITE_CONTENT_SID=

# ── ElevenLabs (voice synthesis) ────────────────────────────────────────────────────
# Ask ScheduRx speaks its replies aloud, and the missed-call greeting upgrades
# from Twilio's built-in <Say> voice to a cached natural one, without either
# without this.
ELEVENLABS_API_KEY=
# "Rachel" — a stable premade ElevenLabs voice — is the default; override for
# a cloned/custom voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Patient booking app origin ──────────────────────────────────────────────────────
# schedurx-form-agent's deployed origin (no trailing slash), e.g.
# "https://book.schedurx.com" — turns tool-helpers.js's relative formUrl()
# into a real link in booking-confirmation/reminder messages, and is always
# allowed as an /api/v1/public CORS origin. Left unset, those messages just
# omit the link.
PATIENT_APP_BASE_URL=

# ── Staff dashboard origin ──────────────────────────────────────────────────────────
# The dashboard's deployed origin (no trailing slash), e.g.
# "https://app.schedurx.com" — used to build team-invite links. Left unset,
# invites are created but no delivery (WhatsApp/SMS) is attempted.
DASHBOARD_BASE_URL=
